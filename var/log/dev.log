[2025-04-04T15:12:28.246281+02:00] doctrine.DEBUG: Executing statement: INSERT INTO creations (nom, taille, prix, description, image_path) VALUES (?, ?, ?, ?, ?) (parameters: array{"1":"Veste en laine rouge","2":"36","3":32.0,"4":"Cette veste en laine est un vêtement d'hiver incontournable. Conçue dans une laine de qualité supérieure, elle offre une chaleur agréable tout en étant légère. Sa coupe élégante et sa texture douce font d’elle une pièce idéale pour les journées fraîches. Dotée de poches pratiques et d'une fermeture zippée ou boutonnée, elle combine confort et fonctionnalité. Son design minimaliste permet de la porter avec n’importe quelle tenue, qu'il s’agisse d'un look décontracté ou plus sophistiqué. Un must-have pour affronter l'hiver avec style.","5":"Veste_epaisse.jpeg"}, types: array{"1":2,"2":2,"3":2,"4":2,"5":2}) {"sql":"INSERT INTO creations (nom, taille, prix, description, image_path) VALUES (?, ?, ?, ?, ?)","params":{"1":"Veste en laine rouge","2":"36","3":32.0,"4":"Cette veste en laine est un vêtement d'hiver incontournable. Conçue dans une laine de qualité supérieure, elle offre une chaleur agréable tout en étant légère. Sa coupe élégante et sa texture douce font d’elle une pièce idéale pour les journées fraîches. Dotée de poches pratiques et d'une fermeture zippée ou boutonnée, elle combine confort et fonctionnalité. Son design minimaliste permet de la porter avec n’importe quelle tenue, qu'il s’agisse d'un look décontracté ou plus sophistiqué. Un must-have pour affronter l'hiver avec style.","5":"Veste_epaisse.jpeg"},"types":{"1":2,"2":2,"3":2,"4":2,"5":2}} []
